---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** トップページのみ true（タイトルに事務所名だけを出す） */
  home?: boolean;
  /** 検索に出さないページ（404 など）で true。canonical も出さない */
  noindex?: boolean;
  /** 検索結果に出す題名（地域名入り）。指定すると「seoTitle｜事務所名」になる */
  seoTitle?: string;
  /** パンくず（ホームの次から）。省略時は「ホーム > title」 */
  breadcrumbs?: { name: string; href: string }[];
  /** ページ固有の構造化データ（検索エンジン向けの補助情報）を足すとき */
  jsonLd?: Record<string, unknown>[];
}
const { title, description = site.description, home = false, noindex = false, seoTitle, breadcrumbs, jsonLd = [] } = Astro.props;
// 題名：トップ＝事務所名＋説明／seoTitle あり＝地域名入りの題名＋事務所名／それ以外＝ページ名＋事務所名（奈良市）
const fullTitle = home || !title
  ? `${site.name}｜奈良市の許認可申請・建設業許可の行政書士`
  : seoTitle
    ? `${seoTitle}｜${site.name}`
    : `${title}｜${site.name}（${site.locality}）`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// SNS・LINE で共有したときの画像（public/og.png、1200×630。scripts/make_og_image.py で作る）
const ogImage = new URL('/og.png', Astro.site);

// ---- 構造化データ（検索エンジンに事務所・ページの位置づけを伝える） ----
const officeId = `${site.domain}/#office`;
const office = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  '@id': officeId,
  name: site.name,
  url: site.domain,
  image: ogImage.href,
  telephone: `+81-${site.tel.replace(/^0/, '')}`,
  faxNumber: `+81-${site.fax.replace(/^0/, '')}`,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    postalCode: site.postal.replace('〒', ''),
    addressRegion: '奈良県',
    addressLocality: '奈良市',
    streetAddress: '西大寺南町16番19号',
    addressCountry: 'JP',
  },
  areaServed: site.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.openingHours.days,
    opens: site.openingHours.opens,
    closes: site.openingHours.closes,
  }],
  founder: { '@type': 'Person', name: site.representative, jobTitle: site.representativeTitle },
};
const structured: Record<string, unknown>[] = [office];
if (home) {
  structured.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.domain, inLanguage: 'ja' });
}
if (!home && !noindex && title) {
  const trail = [{ name: 'ホーム', href: '/' }, ...(breadcrumbs ?? [{ name: title, href: Astro.url.pathname }])];
  structured.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.href, Astro.site).href,
    })),
  });
}
for (const extra of jsonLd) structured.push({ '@context': 'https://schema.org', ...extra });
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}（奈良市西大寺）`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    {structured.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <a class="skip sr-only" href="#main">本文へ移動</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
