---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';

// 法定手数料の参考値。報酬額は個別見積のため掲載しない（2026-11-08 オーナー決定）。
// ※ 金額は一般的な額で、申請先の現行額では未確認（2026-11-08 オーナー了承のうえ注記を強めて掲載）。申請先で確認できたら直す。
const fees = [
  { name: '建設業許可（新規・知事許可）', fee: '90,000円', note: '許可手数料。大臣許可は登録免許税150,000円' },
  { name: '建設業許可（更新・業種追加・知事許可）', fee: '50,000円', note: '1申請区分につき' },
  { name: '経営事項審査', fee: '11,000円〜', note: '審査業種数により加算。別途、経営状況分析の手数料' },
  { name: '宅地建物取引業免許（新規・更新・知事免許）', fee: '33,000円', note: '別途、営業保証金または保証協会分担金' },
  { name: '産業廃棄物収集運搬業許可（新規）', fee: '81,000円', note: '都道府県・政令市ごとに必要。更新は73,000円' },
  { name: '古物商許可', fee: '19,000円', note: '警察署へ納付' },
  { name: '農地法3条・4条・5条許可', fee: 'なし', note: '添付書類の取得実費のみ' },
];
---
<Base title="料金について" description="亀田行政書士事務所の料金の考え方。報酬は案件の内容に応じて事前にお見積りし、法定手数料などの実費と分けてご提示します。">
  <div class="page-hero">
    <div class="container">
      <span class="en">Price</span>
      <h1>料金について</h1>
      <p>費用は「報酬」と「法定費用などの実費」に分けて、事前に書面でご提示します。</p>
    </div>
  </div>
  <section class="section">
    <div class="container prose">
      <h2>料金の考え方</h2>
      <p>
        許認可の申請は、同じ手続きでも会社の状況（証明資料の有無、営業所の数、対象業種の数など）によって作業量が大きく異なります。
        当事務所では、初回相談で内容を伺ったうえで<strong>案件ごとにお見積り</strong>し、ご納得いただいてから着手します。
        お見積り後に追加費用が発生する場合は、必ず事前にご説明します。
      </p>
      <ul>
        <li><strong>報酬</strong>：当事務所の業務に対する費用（消費税別）</li>
        <li><strong>実費</strong>：官公署に納める申請手数料・登録免許税、証明書の取得費用、郵送費など</li>
      </ul>
      <p>お支払いは、原則として着手時に実費相当額をお預かりし、業務完了時に報酬をご請求します。分割でのお支払いもご相談ください。</p>

      <h2>主な手続きの法定手数料（参考・目安）</h2>
      <p class="note">官公署に納める実費の目安として一般的な額を掲げています。自治体・申請先や申請区分により異なり、改定されていることもありますので、この表の金額を保証するものではありません。正確な額は、お見積り時に申請先の現行額を確認してご案内します。</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>手続き</th><th>法定手数料（目安）</th><th>備考</th></tr>
          </thead>
          <tbody>
            {fees.map((f) => (
              <tr><td>{f.name}</td><td>{f.fee}</td><td>{f.note}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>顧問契約について</h2>
      <p>
        建設業許可をお持ちの会社では、毎年の決算変更届、5年ごとの更新、経営事項審査、入札参加資格の継続申請と、手続きが途切れません。
        年間の手続きをまとめてお引き受けする顧問契約もご用意しています。期限管理を当事務所が行い、必要な時期にこちらからご連絡します。
      </p>
    </div>
  </section>
  <Cta />
</Base>
