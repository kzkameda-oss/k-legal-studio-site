---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';

// 料金ページ（2026-11-10 組み替え）。報酬の目安（〇円〜）は 2026-11-10 オーナー指示でいったん保留。
// 数字が決まったら各行に「報酬の目安（税別）」の列を足す（候補と集計は 行政書士\ホームページ\下書き\根拠\2026-11-10_料金の目安_請求実績の集計.md）。
// 法定手数料は「地方公共団体の手数料の標準に関する政令」の額で、奈良県・京都府の条例額と一致することを
// 各業務ページの調査（2026-11-09〜10）で確認済み。改定があれば各業務ページの法定手数料の表と一緒に直す。
const updated = '2026年11月';

type Row = { name: string; legal: string; note?: string };
type Group = { title: string; href: string; rows: Row[] };

const groups: Group[] = [
  {
    title: '建設業許可',
    href: '/services/kensetsu/',
    rows: [
      { name: '新規（知事許可）', legal: '90,000円', note: '一般と特定の両方を申請するときはそれぞれ必要。大臣許可は登録免許税150,000円' },
      { name: '更新', legal: '50,000円', note: '5年ごと' },
      { name: '業種追加', legal: '50,000円', note: '更新と同時のときは合算' },
      { name: '変更届（役員・営業所技術者等・資本金など）', legal: 'なし' },
    ],
  },
  {
    title: '決算変更届',
    href: '/services/kessan-henko/',
    rows: [
      { name: '毎年の決算変更届（事業年度終了届）', legal: 'なし', note: '事業年度の終了から4か月以内' },
    ],
  },
  {
    title: '経営事項審査・入札参加資格',
    href: '/services/keishin/',
    rows: [
      { name: '経営事項審査（経営規模等評価の申請＋総合評定値の請求）', legal: '11,000円〜', note: '1業種の額。1業種増すごとに＋2,500円。別途、登録経営状況分析機関の分析手数料' },
      { name: '入札参加資格の申請・変更届', legal: 'なし' },
    ],
  },
  {
    title: '農地転用・農地法',
    href: '/services/nochi/',
    rows: [
      { name: '3条・4条・5条の許可、市街化区域の届出', legal: 'なし', note: '登記事項証明書・公図などの実費、土地改良区の決済金（受益地の場合）は別途' },
    ],
  },
  {
    title: '産業廃棄物収集運搬業許可',
    href: '/services/sanpai/',
    rows: [
      { name: '新規', legal: '81,000円', note: '積込み地・荷下ろし地の府県ごとに必要' },
      { name: '更新', legal: '73,000円', note: '5年ごと' },
      { name: '変更許可（品目の追加など）', legal: '71,000円' },
      { name: '変更届（車両・役員など）', legal: 'なし' },
    ],
  },
  {
    title: 'その他の手続き',
    href: '/services/',
    rows: [
      { name: '宅地建物取引業免許（新規・更新、知事免許）', legal: '33,000円', note: '別途、営業保証金の供託または保証協会の分担金' },
      { name: '古物商許可', legal: '19,000円', note: '警察署へ納付' },
    ],
  },
];

const faq = [
  {
    q: '報酬はどのように決まりますか。',
    a: '手続きの種類を基本に、申請する業種や府県の数、証明資料の揃い具合、過去の未提出の届出の有無、図面の作成や隣接地の同意取得の量などを伺って決めます。初回相談で内容をお聞きしたうえで、報酬と実費を分けた書面のお見積りをお出しします。',
  },
  {
    q: 'お見積りに費用はかかりますか。',
    a: 'かかりません。初回のご相談とお見積りは無料です。お見積りの内容にご納得いただいてから委任契約を結び、着手します。',
  },
  {
    q: '支払いはいつですか。',
    a: '原則として、着手時に法定手数料などの実費相当額をお預かりし、業務が完了したときに報酬をご請求します。お支払いの時期や分割についてはご相談ください。',
  },
];

const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="料金について"
  seoTitle="料金について（報酬の考え方と法定手数料）"
  description="亀田行政書士事務所（奈良市）の料金の考え方。報酬は案件の内容に応じて事前に書面でお見積りし、建設業許可・経営事項審査・産廃収集運搬業許可などの法定手数料と分けてご提示します。"
  jsonLd={jsonLd}
>
  <div class="page-hero">
    <div class="container">
      <span class="en">Price</span>
      <h1>料金について</h1>
      <p>費用は「報酬」と「法定手数料などの実費」に分けて、着手前に書面でお見積りします。</p>
    </div>
  </div>
  <section class="section">
    <div class="container prose">
      <h2>料金の考え方</h2>
      <p>
        許認可の申請は、同じ手続きでも会社の状況（証明資料の有無、営業所の数、対象業種の数など）によって作業量が大きく異なります。
        当事務所では、初回相談で内容を伺ったうえで<strong>案件ごとにお見積り</strong>し、ご納得いただいてから着手します。
        お見積り後に追加費用が発生する場合は、必ず事前にご説明します。
      </p>
      <ul>
        <li><strong>報酬</strong>：当事務所の業務に対する費用（消費税別）</li>
        <li><strong>実費</strong>：官公署に納める申請手数料・登録免許税、証明書の取得費用、郵送費など。かかった額をそのままご請求します</li>
      </ul>

      <h2>報酬に含まれるもの・含まれないもの</h2>
      <ul>
        <li><strong>含まれるもの</strong>：申請書・届出書と添付書類の作成、申請先との事前相談と日程調整、申請の代理（窓口への提出・郵送）、補正への対応、許可・受理後の副本や通知書のお届け</li>
        <li><strong>含まれないもの</strong>：法定手数料、住民票・登記事項証明書・納税証明書などの証明書の実費、郵送費、講習会の受講料、経営状況分析の手数料、土地家屋調査士・設計事務所など他の専門家に依頼する費用</li>
      </ul>

      <h2>主な手続きの法定手数料</h2>
      <p class="note">
        官公署に納める実費の額です（{updated}時点）。奈良県・京都府の知事許可を前提にした額で、国の政令で定める標準額と同じです。
        改定されることがありますので、お見積りのときに申請先の現行額を確認してご案内します。
      </p>
      {groups.map((g) => (
        <>
          <h3><a href={g.href}>{g.title}</a></h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>手続き</th><th>法定手数料</th><th>備考</th></tr>
              </thead>
              <tbody>
                {g.rows.map((r) => (
                  <tr><td>{r.name}</td><td>{r.legal}</td><td>{r.note ?? ''}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ))}
      <p>帰化申請、会社設立、事業協同組合の設立・変更、公正証書の作成支援、社会保険の手続きなど、表にない業務も内容を伺ってお見積りします。</p>

      <h2>お支払い</h2>
      <p>原則として、着手時に実費相当額をお預かりし、業務完了時に報酬をご請求します。銀行振込でお願いしています。お支払いの時期や分割についてはご相談ください。</p>

      <h2>顧問契約について</h2>
      <p>
        建設業許可をお持ちの会社では、毎年の決算変更届、5年ごとの更新、経営事項審査、入札参加資格の継続申請と、手続きが途切れません。
        年間の手続きをまとめてお引き受けする顧問契約もご用意しています。期限管理を当事務所が行い、必要な時期にこちらからご連絡します。料金は手続きの数に応じてお見積りします。
      </p>

      <section class="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">よくあるご質問</h2>
        <dl>
          {faq.map((f) => (
            <div class="faq__item">
              <dt><span class="faq__mark" aria-hidden="true">Q</span>{f.q}</dt>
              <dd><span class="faq__mark faq__mark--a" aria-hidden="true">A</span>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </section>
  <Cta />
</Base>

<style>
  .prose h3 a { color: var(--navy); text-decoration: none; }
  .prose h3 a:hover { text-decoration: underline; }
  .faq dl { margin: 0; }
  .faq__item { background: var(--bg-white); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; margin-bottom: 12px; }
  .faq__item dt { font-weight: 700; color: var(--navy); display: grid; grid-template-columns: 28px 1fr; gap: 8px; }
  .faq__item dd { margin: 10px 0 0; display: grid; grid-template-columns: 28px 1fr; gap: 8px; }
  .faq__mark { font-family: var(--font-serif); font-weight: 700; color: var(--gold); line-height: 1.6; }
  .faq__mark--a { color: var(--navy); }
  @media (max-width: 600px) {
    .table-wrap table { min-width: 0; width: 100%; }
    .table-wrap th { white-space: normal; }
  }
</style>
