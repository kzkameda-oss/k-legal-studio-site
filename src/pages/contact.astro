---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const hasForm = Boolean(site.formEndpoint);
const mailSubject = encodeURIComponent('ご相談の申込み（ホームページより）');
const mailBody = encodeURIComponent('会社名・お名前：\n電話番号：\nご相談内容（例：建設業許可の新規取得）：\n\n');
---
<Base title="お問い合わせ" description={`${site.name}へのお問い合わせ。初回相談は無料です。お電話（${site.tel}）${hasForm ? '・メール・お問い合わせフォーム' : 'またはメール'}でお気軽にご連絡ください。`}>
  <div class="page-hero">
    <div class="container">
      <span class="en">Contact</span>
      <h1>お問い合わせ</h1>
      <p>初回のご相談は無料です。{hasForm ? 'お電話・メール・お問い合わせフォームでご連絡ください。' : 'お電話またはメールでご連絡ください。'}</p>
    </div>
  </div>

  <section class="section">
    <div class="container contact">
      <div class="contact__box">
        <h2>お電話でのお問い合わせ</h2>
        <p class="contact__tel"><a href={site.telHref}>{site.tel}</a></p>
        <p class="note">{site.hours}<br />外出中で出られない場合は折り返しご連絡します。</p>
      </div>
      <div class="contact__box">
        <h2>メールでのお問い合わせ</h2>
        <p class="contact__mail"><a href={`mailto:${site.email}?subject=${mailSubject}&body=${mailBody}`}>{site.email}</a></p>
        <p class="note">会社名・お名前・電話番号・ご相談内容をご記入ください。<br />原則として1営業日以内にご返信します。</p>
      </div>
    </div>

    {hasForm && (
      <div class="container" style="margin-top:56px">
        <div class="section-head">
          <span class="en">Form</span>
          <h2>お問い合わせフォーム</h2>
          <p>下記のフォームからもご相談いただけます。原則として1営業日以内にご返信します。</p>
        </div>
        <div class="form-done" id="contact-done" tabindex="-1" hidden>
          <h3>送信しました</h3>
          <p>お問い合わせありがとうございます。内容を確認のうえ、原則として1営業日以内にご連絡します。<br />お急ぎの場合はお電話（<a href={site.telHref}>{site.tel}</a>）でご連絡ください。</p>
        </div>
        <form class="form" id="contact-form" action={site.formEndpoint} method="POST" accept-charset="UTF-8">
          <div class="form__row">
            <label for="company">会社名・屋号</label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="form__row">
            <label for="name">お名前 <span class="req">必須</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="form__row">
            <label for="email">メールアドレス <span class="req">必須</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="form__row">
            <label for="tel">電話番号</label>
            <input id="tel" name="tel" type="tel" autocomplete="tel" />
          </div>
          <div class="form__row">
            <label for="service">ご相談の種類</label>
            <select id="service" name="service">
              <option value="">選択してください</option>
              {services.map((s) => (<option value={s.data.title}>{s.data.title}</option>))}
              <option value="その他">その他・分からない</option>
            </select>
          </div>
          <div class="form__row">
            <label for="message">ご相談内容 <span class="req">必須</span></label>
            <textarea id="message" name="message" rows="7" required aria-describedby="message-hint"></textarea>
            <p class="note" id="message-hint">概要だけで結構です（例：建設業許可を新しく取りたい、決算変更届が数年分たまっている）。詳しい事情は折り返しのご連絡で伺います。</p>
          </div>
          <input type="hidden" name="_subject" value="ホームページからのお問い合わせ" />
          <div class="form__hp" aria-hidden="true">
            <label for="gotcha">この欄は入力しないでください</label>
            <input id="gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <p class="note">
            このフォームは米国 Formspree, Inc. のフォーム送信サービスを利用しており、入力された内容は同社のサーバー（米国）を経由して当事務所に届きます。
            内容は<a href="/privacy/">プライバシーポリシー</a>に基づき取り扱います。ご確認のうえ送信してください。
          </p>
          <p class="form__error" id="contact-error" role="alert" hidden>
            送信できませんでした。お手数ですが、お電話（<a href={site.telHref}>{site.tel}</a>）またはメール（<a href={`mailto:${site.email}`}>{site.email}</a>）でご連絡ください。
          </p>
          <button class="btn btn--primary" type="submit">送信する</button>
        </form>
      </div>
    )}

    <div class="container prose" style="margin-top:56px">
      <h2>ご相談の前に</h2>
      <ul>
        <li>ご相談は面談のほか、電話・オンライン（Zoom等）でも承ります。</li>
        <li>会社の登記事項証明書、決算書、既にお持ちの許可証などをご用意いただくと、より具体的なご案内ができます。</li>
        <li>お急ぎの場合はその旨をお知らせください。可能な限り優先して対応します。</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 760px) { .contact { grid-template-columns: 1fr; } }
  .contact__box { background: var(--bg-white); border: 1px solid var(--line); border-top: 4px solid var(--gold); border-radius: var(--radius); padding: 32px 28px; text-align: center; }
  .contact__box h2 { font-size: 1.15rem; margin-bottom: 14px; }
  .contact__tel a { font-family: var(--font-serif); font-size: 2.2rem; font-weight: 700; text-decoration: none; }
  .contact__mail a { font-size: 1.15rem; font-weight: 700; word-break: break-all; }
  .form { max-width: 680px; background: var(--bg-white); border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; display: grid; gap: 18px; }
  .form__row { display: grid; gap: 6px; }
  .form label { font-weight: 700; font-size: 0.95rem; }
  .req { display: inline-block; font-size: 0.7rem; background: #b3423a; color: #fff; padding: 1px 6px; border-radius: 3px; margin-left: 6px; vertical-align: middle; }
  .form input, .form select, .form textarea { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 4px; background: #fff; width: 100%; }
  .form input:focus, .form select:focus, .form textarea:focus { outline: 2px solid var(--gold); border-color: var(--gold); }
  .form button { justify-self: start; }
  .form[hidden] { display: none; }
  .form button[disabled] { opacity: 0.6; cursor: default; }
  .form__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form__error { margin: 0; padding: 12px 14px; border: 1px solid #b3423a; border-radius: 4px; background: #fbefee; color: #7a2a24; font-size: 0.95rem; }
  .form-done { max-width: 680px; background: var(--bg-white); border: 1px solid var(--line); border-top: 4px solid var(--gold); border-radius: var(--radius); padding: 32px; }
  .form-done h3 { margin: 0 0 10px; font-size: 1.2rem; }
  .form-done p { margin: 0; }
  .form-done:focus { outline: none; }
  @media (max-width: 600px) { .form, .form-done { padding: 22px 18px; } }
</style>

<script>
  // フォームの送信をページを移動せずに行う（Formspree の送信先へ fetch で POST）。
  // JavaScript が動かない環境では通常の送信になり、Formspree の完了ページが表示される。
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const done = document.getElementById('contact-done');
    const error = document.getElementById('contact-error');
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (error) error.hidden = true;
      if (button) { button.disabled = true; button.textContent = '送信中…'; }
      let ok = false;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        ok = res.ok;
      } catch {
        ok = false;
      }
      if (ok) {
        form.reset();
        if (button) { button.disabled = false; button.textContent = '送信する'; }
        form.hidden = true;
        if (done) { done.hidden = false; done.focus(); done.scrollIntoView({ block: 'center' }); }
      } else {
        if (error) error.hidden = false;
        if (button) { button.disabled = false; button.textContent = '送信する'; }
      }
    });
  }
</script>
