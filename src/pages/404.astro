---
// 存在しない URL 用のページ。Cloudflare Pages は dist/404.html があるとステータス 404 でこれを返す
// （無いと SPA 扱いになり、どの URL でもトップページを 200 で返してしまう）。
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<Base title="ページが見つかりません" description="お探しのページは見つかりませんでした。" noindex>
  <div class="page-hero">
    <div class="container">
      <span class="en">404 Not Found</span>
      <h1>ページが見つかりません</h1>
      <p>お探しのページは、移動または削除された可能性があります。</p>
    </div>
  </div>
  <section class="section">
    <div class="container prose">
      <p>URL をご確認いただくか、下記のページからお探しください。</p>
      <ul>
        <li><a href="/">トップページ</a></li>
        <li><a href="/services/">業務案内</a>
          <ul>
            {services.map((s) => <li><a href={`/services/${s.id}/`}>{s.data.title}</a></li>)}
          </ul>
        </li>
        <li><a href="/flow/">ご依頼の流れ</a></li>
        <li><a href="/price/">料金について</a></li>
        <li><a href="/about/">事務所案内</a></li>
        <li><a href="/contact/">お問い合わせ</a></li>
      </ul>
      <p>お急ぎの場合はお電話でご連絡ください。<br /><a href={site.telHref}><strong>{site.tel}</strong></a>（{site.hours}）</p>
    </div>
  </section>
</Base>
