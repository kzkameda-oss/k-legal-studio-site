---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
---
<Base title="事務所案内" description={`${site.name}の事務所案内。所在地は${site.address}。代表 ${site.representativeTitle} ${site.representative}。アクセス・受付時間・対応エリアをご案内します。`}>
  <div class="page-hero">
    <div class="container">
      <span class="en">About</span>
      <h1>事務所案内</h1>
      <p>奈良市西大寺から、奈良・京都・大阪の事業者の皆さまをサポートします。</p>
    </div>
  </div>

  <section class="section">
    <div class="container prose">
      <h2>ごあいさつ</h2>
      <p>
        亀田行政書士事務所のウェブサイトをご覧いただき、ありがとうございます。
      </p>
      <p>
        当事務所は、建設業許可・経営事項審査・農地転用・産業廃棄物収集運搬業許可など、事業者の皆さまの「許可」に関する手続きを専門に扱う行政書士事務所です。
        許認可は、事業を始めるとき、広げるとき、そして続けていくときに必ず関わってくるものです。
        書類を作って提出するだけでなく、「今の状況で許可が取れるのか」「取ったあと何をすればよいのか」まで、事業の隣で一緒に考える存在でありたいと思っています。
      </p>
      <p>
        登記や税務など他の専門家の力が必要な場面では、提携する司法書士・税理士・社会保険労務士・土地家屋調査士と連携し、窓口を一つにして対応します。
        どうぞお気軽にご相談ください。
      </p>
      <p class="sign">{site.name}<br />{site.representativeTitle}　{site.representative}</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="en">Overview</span>
        <h2>事務所概要</h2>
      </div>
      <div class="overview">
        <dl class="dl">
          <dt>事務所名</dt><dd>{site.name}</dd>
          <dt>代表者</dt><dd>{site.representativeTitle}　{site.representative}</dd>
          <dt>登録</dt><dd>{site.association}　登録番号 {site.registrationNo}</dd>
          <dt>所在地</dt><dd>{site.postal}　{site.address}</dd>
          <dt>電話</dt><dd><a href={site.telHref}>{site.tel}</a></dd>
          <dt>FAX</dt><dd>{site.fax}</dd>
          <dt>メール</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          <dt>受付時間</dt><dd>{site.hours}</dd>
          <dt>対応エリア</dt><dd>{site.area}</dd>
          <dt>主な業務</dt><dd>建設業許可・経営事項審査・入札参加資格／農地転用／産業廃棄物収集運搬業許可／宅地建物取引業免許／古物商許可／帰化申請／会社設立・企業法務／遺言・相続</dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="en">Access</span>
        <h2>アクセス</h2>
        <p>{site.access}。お車でお越しの際は事前にご連絡ください。</p>
      </div>
      <div class="map">
        <iframe
          title="事務所の地図"
          src={`https://www.google.com/maps?q=${encodeURIComponent(site.address)}&output=embed&z=16`}
          width="100%" height="420" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="note" style="margin:10px 0 0;text-align:right"><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`} target="_blank" rel="noopener">Googleマップで開く</a></p>
    </div>
  </section>
  <Cta />
</Base>

<style>
  .sign { text-align: right; font-family: var(--font-serif); font-size: 1.05rem; margin-top: 2em; }
  .overview { background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px 32px; max-width: 820px; }
  .map { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #fff; }
</style>
