---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';

const steps = [
  { title: 'お問い合わせ', text: 'お電話またはお問い合わせフォームからご連絡ください。「許可が取れるか分からない」という段階で結構です。簡単に状況を伺い、面談の日程を調整します。' },
  { title: '初回相談（無料）', text: '事務所またはお客様の会社にてお話を伺います。オンライン相談も可能です。許可の要件を満たしているか、どのような書類が必要か、期間の見通しをご説明します。' },
  { title: 'お見積り・ご契約', text: '報酬と法定費用（申請手数料・証明書取得費など）を分けて、書面でお見積りをご提示します。内容にご納得いただけましたら委任契約を締結します。' },
  { title: '必要書類のご案内・収集', text: 'お客様にご用意いただく書類と、当事務所で取得する書類（登記事項証明書・納税証明書など）を分けてご案内します。集めた書類は預り証をお渡しし、責任をもって管理します。' },
  { title: '申請書類の作成・ご確認', text: '申請書一式を作成し、内容をご確認いただきます。要件の裏付けとなる資料の整理や、官公署との事前協議もこの段階で行います。' },
  { title: '申請', text: '当事務所が官公署へ申請します。申請後の補正や追加資料の求めにも対応します。' },
  { title: '許可・納品', text: '許可通知書・許可証を受領し、控えと一緒にお渡しします。取得後に必要な届出や更新期限もあわせてご案内し、今後の期限管理をサポートします。' },
];
---
<Base title="ご依頼の流れ" description="亀田行政書士事務所へのご依頼の流れ。お問い合わせから初回無料相談、お見積り、書類収集、申請、許可までの手順をご説明します。">
  <div class="page-hero">
    <div class="container">
      <span class="en">Flow</span>
      <h1>ご依頼の流れ</h1>
      <p>初回のご相談から許可の取得まで、7つのステップで進めます。</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <ol class="steps" style="max-width:820px">
        {steps.map((s) => (
          <li class="step">
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="prose" style="margin-top:48px">
        <h2>ご相談にあたって</h2>
        <ul>
          <li>初回相談は無料です。2回目以降のご相談も、ご依頼いただいた案件に関するものは費用をいただきません。</li>
          <li>ご相談の際は、会社の登記事項証明書や決算書など、お手元にある資料をお持ちいただくと見通しが立てやすくなります。</li>
          <li>受付時間は{site.hours}です。土日祝・夜間のご相談もご予約いただければ対応します。</li>
          <li>ご相談内容は守秘義務に基づき厳重に管理します。</li>
        </ul>
      </div>
    </div>
  </section>
  <Cta />
</Base>
