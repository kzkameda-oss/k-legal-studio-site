---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import { getArticles } from '../data/articles';

// 新しい解説記事（最大4件）
const articles = (await getArticles()).slice(0, 4);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = services.filter((s) => s.data.featured);
const rest = services.filter((s) => !s.data.featured);

const strengths = [
  {
    title: '許認可の実務に特化',
    text: '建設業許可・経営事項審査・農地転用・産廃許可など、事業に直結する許認可を中心に扱っています。要件の判断から書類収集、官公署との折衝までお任せください。',
  },
  {
    title: '取得後の「維持」まで伴走',
    text: '決算変更届・更新・変更届など、許可を維持するための年次手続きを期限管理込みでサポート。「気づいたら期限切れ」を防ぎます。',
  },
  {
    title: '奈良・京都・大阪に対応',
    text: '奈良県を中心に、京都府南部・大阪府の許可行政庁への申請実績があります。複数の都道府県にまたがる産廃許可なども一括で対応します。',
  },
  {
    title: '他士業と連携したワンストップ対応',
    text: '登記・税務・労務が絡む案件は、提携する司法書士・税理士・社会保険労務士と連携。窓口は当事務所ひとつで完結します。',
  },
];

// ヒーローの4つの特長（アイコンは線画の SVG パス。文言は「当事務所の特長」と同じ事実だけ）
const points = [
  { label: '初回相談<br />無料', icon: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M8.5 11h7M8.5 14h4"/>' },
  { label: '取得から<br />維持まで', icon: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4M9 14.5l2 2 4-4"/>' },
  { label: '奈良・京都<br />大阪に対応', icon: '<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>' },
  { label: '他士業と<br />連携', icon: '<circle cx="8" cy="8.5" r="3"/><circle cx="16.5" cy="8.5" r="3"/><path d="M2.5 19.5c.6-3 2.8-4.8 5.5-4.8s4.9 1.8 5.5 4.8M13.2 15.2c1-.4 2.1-.5 3.3-.5 2.7 0 4.9 1.8 5.5 4.8"/>' },
];
---
<Base home>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__body">
        <p class="hero__kicker">Administrative Scrivener · Nara</p>
        <p class="hero__eyebrow">奈良市西大寺の行政書士事務所</p>
        <h1 class="hero__title">許認可のことは、<br />事業のいちばん近くで。</h1>
        <p class="hero__lead">
          建設業許可・経営事項審査・農地転用・産業廃棄物収集運搬業許可・宅建業免許。<br class="pc" />
          事業を進めるために必要な「許可」を、取得から維持まで一貫してお手伝いします。
        </p>
        <ul class="hero__points">
          {points.map((p) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
              <span set:html={p.label} />
            </li>
          ))}
        </ul>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact/">無料相談を申し込む</a>
          <a class="btn btn--outline" href="/services/">業務案内を見る</a>
        </div>
        <p class="hero__tel">
          お電話でのご相談　<a href={site.telHref}>{site.tel}</a>
          <span>{site.hours}</span>
        </p>
      </div>
      <div class="hero__panel">
        <p class="hero__panel-en">Services</p>
        <p class="hero__panel-title">主な取扱業務</p>
        <ul>
          {featured.map((s) => (
            <li><a href={`/services/${s.id}/`}>{s.data.title}</a></li>
          ))}
          <li><a href="/services/">その他の許認可・手続き</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="en">Services</span>
        <h2>業務案内</h2>
        <p>事業者の皆さまからご依頼の多い許認可を中心に、幅広い手続きに対応しています。</p>
      </div>
      <div class="grid grid--2">
        {featured.map((s) => (
          <a class="card" href={`/services/${s.id}/`}>
            <h3>{s.data.title}</h3>
            <p>{s.data.catch}</p>
            <span class="more">詳しく見る</span>
          </a>
        ))}
      </div>
      <div class="grid grid--4 grid--sub">
        {rest.map((s) => (
          <a class="card card--compact" href={`/services/${s.id}/`}>
            <h3>{s.data.title}</h3>
            <p>{s.data.catch}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="en">Why us</span>
        <h2>当事務所の特長</h2>
      </div>
      <div class="grid grid--2">
        {strengths.map((s, i) => (
          <div class="strength">
            <span class="strength__no">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="en">Flow</span>
        <h2>ご依頼の流れ</h2>
        <p>初回相談から許可取得まで、おおまかな流れです。</p>
      </div>
      <ol class="flow-mini">
        <li><strong>お問い合わせ</strong><span>電話・メールでご連絡</span></li>
        <li><strong>初回相談（無料）</strong><span>要件の確認・見通しのご説明</span></li>
        <li><strong>お見積り・ご契約</strong><span>費用と期間を書面でご提示</span></li>
        <li><strong>書類収集・作成</strong><span>必要書類の案内と申請書の作成</span></li>
        <li><strong>申請・許可</strong><span>官公署へ申請、許可証をお渡し</span></li>
      </ol>
      <p class="center"><a class="btn btn--outline" href="/flow/">流れの詳細を見る</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container office">
      <div>
        <div class="section-head">
          <span class="en">Office</span>
          <h2>事務所案内</h2>
        </div>
        <dl class="dl">
          <dt>事務所名</dt><dd>{site.name}</dd>
          <dt>代表</dt><dd>{site.representativeTitle}　{site.representative}<br /><small>{site.association}　登録番号 {site.registrationNo}</small></dd>
          <dt>所在地</dt><dd>{site.postal}　{site.address}</dd>
          <dt>電話</dt><dd><a href={site.telHref}>{site.tel}</a></dd>
          <dt>受付時間</dt><dd>{site.hours}</dd>
          <dt>アクセス</dt><dd>{site.access}</dd>
          <dt>対応エリア</dt><dd>{site.area}</dd>
        </dl>
        <p style="margin-top:24px"><a class="btn btn--outline" href="/about/">事務所案内・アクセス</a></p>
      </div>
      <div class="office__map">
        <iframe
          title="事務所の地図"
          src={`https://www.google.com/maps?q=${encodeURIComponent(site.address)}&output=embed&z=16`}
          width="100%" height="320" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <p class="note" style="margin:10px 0 0;text-align:right"><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`} target="_blank" rel="noopener">Googleマップで開く</a></p>
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head">
          <span class="en">Articles</span>
          <h2>解説記事</h2>
          <p>許認可の期限や手続きの進め方を、法令と申請先の手引きに基づいて解説しています。</p>
        </div>
        <div class="grid grid--2">
          {articles.map((a) => (
            <a class="card" href={`/articles/${a.id}/`}>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
              <span class="more">続きを読む</span>
            </a>
          ))}
        </div>
        <p class="center" style="margin-top:28px"><a class="btn btn--outline" href="/articles/">解説記事の一覧</a></p>
      </div>
    </section>
  )}

  <Cta />
</Base>

<style>
  .hero { background: linear-gradient(115deg, var(--sand) 0%, var(--pale) 55%, var(--sand) 100%); border-bottom: 1px solid var(--line); position: relative; overflow: hidden; }
  .hero::before { content: ''; position: absolute; right: -160px; top: -200px; width: 620px; height: 620px; border-radius: 50%; background: radial-gradient(circle, rgba(47,111,115,0.10) 0%, rgba(47,111,115,0) 70%); pointer-events: none; }
  .hero__inner { display: grid; grid-template-columns: 1.45fr 1fr; gap: 56px; align-items: center; padding: 88px 20px 96px; position: relative; z-index: 1; }
  @media (max-width: 900px) { .hero__inner { grid-template-columns: 1fr; padding: 56px 20px 64px; gap: 40px; } }
  .hero__kicker { display: flex; align-items: center; gap: 16px; font-family: var(--font-en); font-weight: 700; font-size: 0.82rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
  .hero__kicker::before { content: ''; width: 40px; height: 1px; background: var(--accent); flex-shrink: 0; }
  @media (max-width: 600px) { .hero__kicker { font-size: 0.68rem; letter-spacing: 0.16em; gap: 10px; } .hero__kicker::before { width: 24px; } }
  .hero__eyebrow { color: var(--muted); font-weight: 500; letter-spacing: 0.12em; font-size: 0.85rem; margin-bottom: 18px; }
  .hero__title { font-size: 2.75rem; font-weight: 800; line-height: 1.4; margin-bottom: 24px; letter-spacing: 0.04em; }
  @media (max-width: 600px) { .hero__title { font-size: 1.8rem; letter-spacing: 0.02em; } }
  .hero__lead { font-size: 1rem; color: var(--ink); margin-bottom: 32px; }
  .hero__points { list-style: none; padding: 0; margin: 0 0 36px; display: grid; grid-template-columns: repeat(4, 1fr); max-width: 560px; }
  .hero__points li { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; padding: 4px 8px; font-size: 0.8rem; font-weight: 700; line-height: 1.5; color: var(--navy); }
  .hero__points li + li { border-left: 1px solid var(--line); }
  .hero__points svg { width: 30px; height: 30px; color: var(--navy); }
  @media (max-width: 600px) { .hero__points li { font-size: 0.72rem; padding: 4px 2px; letter-spacing: 0; } .hero__points svg { width: 26px; height: 26px; } }
  .hero__actions { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .hero__actions .btn { min-width: 230px; }
  @media (max-width: 600px) { .hero__actions .btn { width: 100%; } }
  .hero__tel { font-size: 0.9rem; color: var(--muted); margin: 0; }
  .hero__tel a { font-family: var(--font-en); font-size: 1.6rem; font-weight: 700; text-decoration: none; color: var(--navy); letter-spacing: 0.04em; }
  .hero__tel span { display: block; font-size: 0.8rem; }
  .hero__panel { background: #fff; padding: 32px 30px 22px; border-radius: var(--radius-lg); box-shadow: 0 24px 60px rgba(43, 43, 43, 0.08); }
  .hero__panel-en { font-family: var(--font-en); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.3em; color: var(--accent); margin: 0 0 2px; }
  .hero__panel-title { font-weight: 700; color: var(--navy); font-size: 1.15rem; margin-bottom: 14px; }
  .hero__panel ul { list-style: none; margin: 0; padding: 0; }
  .hero__panel li { border-top: 1px solid var(--line); margin: 0; }
  .hero__panel li a { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 2px; color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.95rem; line-height: 1.5; }
  .hero__panel li a::after { content: '→'; flex-shrink: 0; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line); color: var(--navy); font-size: 0.8rem; transition: background .2s, color .2s, border-color .2s; }
  .hero__panel li a:hover { color: var(--navy); }
  .hero__panel li a:hover::after { background: var(--navy); border-color: var(--navy); color: #fff; }
  .sp { display: none; }
  @media (max-width: 600px) { .sp { display: inline; } .pc { display: none; } }

  .grid--sub { margin-top: 24px; }
  .card--compact { padding: 22px 22px; }
  .card--compact h3 { font-size: 1rem; }
  .card--compact p { font-size: 0.85rem; }

  .strength { background: var(--bg-white); border: 1px solid var(--line); border-radius: var(--radius); padding: 34px 32px 28px; position: relative; }
  .strength__no { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--navy); color: #fff; font-family: var(--font-en); font-size: 0.95rem; font-weight: 700; margin-bottom: 18px; }
  .strength h3 { font-size: 1.2rem; margin-bottom: 10px; }
  .strength p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  .flow-mini { list-style: none; padding: 0; margin: 0 0 40px; display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; counter-reset: f; }
  @media (max-width: 860px) { .flow-mini { grid-template-columns: 1fr; } }
  .flow-mini li { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 18px 20px; margin: 0; position: relative; display: flex; flex-direction: column; gap: 6px; }
  .flow-mini li::before { counter-increment: f; content: 'STEP ' counter(f, decimal-leading-zero); font-family: var(--font-en); font-size: 0.72rem; letter-spacing: 0.2em; color: var(--accent); font-weight: 700; }
  .flow-mini strong { color: var(--navy); font-size: 1rem; }
  .flow-mini span { font-size: 0.85rem; color: var(--muted); line-height: 1.7; }
  .center { text-align: center; }

  .office { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  @media (max-width: 860px) { .office { grid-template-columns: 1fr; } }
  .office__map { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); background: #fff; }
</style>
