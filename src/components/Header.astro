---
import { site, nav } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark">亀</span>
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__sub">奈良市西大寺｜許認可申請</span>
      </span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-burger" aria-label="メニュー">
      <span></span><span></span><span></span>
    </label>
    <nav class="site-nav" aria-label="メインメニュー">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <a class="site-nav__tel" href={site.telHref}>
        <span class="site-nav__tel-label">お電話でのご相談</span>
        <span class="site-nav__tel-no">{site.tel}</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(245,241,232,0.92); backdrop-filter: blur(10px); box-shadow: 0 1px 0 var(--line), 0 6px 24px rgba(43, 43, 43, 0.04); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; height: 80px; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--navy); }
  .brand__mark { width: 42px; height: 42px; border-radius: 50%; background: var(--navy); color: #fff; font-size: 1.15rem; font-weight: 700; display: grid; place-items: center; flex-shrink: 0; }
  .brand__text { display: flex; flex-direction: column; line-height: 1.3; }
  .brand__name { white-space: nowrap; font-weight: 700; font-size: 1.12rem; letter-spacing: 0.06em; }
  .brand__sub { font-size: 0.68rem; color: var(--muted); letter-spacing: 0.1em; }
  .site-nav { display: flex; align-items: center; gap: 20px; }
  .site-nav ul { display: flex; list-style: none; margin: 0; padding: 0; gap: 2px; }
  .site-nav li { margin: 0; }
  .site-nav li a { display: block; white-space: nowrap; padding: 6px 12px; text-decoration: none; font-size: 0.9rem; font-weight: 500; color: var(--ink); position: relative; }
  .site-nav li a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 0; height: 1px; background: var(--navy); transform: scaleX(0); transition: transform .2s; }
  .site-nav li a:hover, .site-nav li a[aria-current="page"] { color: var(--navy); }
  .site-nav li a:hover::after, .site-nav li a[aria-current="page"]::after { transform: scaleX(1); }
  .site-nav__tel { display: flex; flex-direction: column; align-items: center; text-decoration: none; background: var(--navy); color: #fff; padding: 7px 26px; border-radius: 999px; line-height: 1.3; box-shadow: 0 6px 18px rgba(47, 111, 115, 0.22); transition: background .2s; }
  .site-nav__tel:hover { background: var(--navy-2); color: #fff; }
  .site-nav__tel-label { font-size: 0.62rem; letter-spacing: 0.1em; color: var(--accent-light); }
  .site-nav__tel-no { white-space: nowrap; font-family: var(--font-en); font-size: 1.05rem; font-weight: 700; letter-spacing: 0.05em; }
  .nav-toggle, .nav-burger { display: none; }

  /* 1行に並べるとロゴ225＋メニュー729＋余白64＝約1,020px要る（スクロールバー込みで約1,035px）。
     960pxで切り替えていたため 961〜1,035px でメニュー文字が2行に折り返していた（2026-11-14修正） */
  @media (max-width: 1080px) {
    .site-header__inner { height: 64px; }
    .site-nav li a::after { display: none; }
    .brand__sub { display: none; }
    .nav-burger { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; padding: 10px; cursor: pointer; }
    .nav-burger span { display: block; height: 2px; background: var(--navy); transition: transform .2s, opacity .2s; }
    .site-nav { position: absolute; top: 64px; left: 0; right: 0; background: var(--sand); border-bottom: 1px solid var(--line); flex-direction: column; align-items: stretch; gap: 0; padding: 8px 20px 20px; display: none; box-shadow: var(--shadow); }
    .site-nav ul { flex-direction: column; gap: 0; }
    .site-nav li a { padding: 12px 4px; border-bottom: 1px solid var(--line); font-size: 1rem; }
    .site-nav__tel { margin-top: 16px; }
    .nav-toggle:checked ~ .site-nav { display: flex; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
