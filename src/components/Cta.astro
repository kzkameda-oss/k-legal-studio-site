---
import { site } from '../data/site';
---
<section class="cta">
  <div class="container cta__inner">
    <div>
      <p class="cta__lead">まずはお気軽にご相談ください</p>
      <h2 class="cta__title">初回のご相談は無料です</h2>
      <p class="cta__text">「うちの場合は許可が取れるのか」「何から準備すればよいか」といった段階からご相談いただけます。お電話またはメールでご連絡ください。</p>
    </div>
    <div class="cta__actions">
      <a class="cta__tel" href={site.telHref}>
        <span class="cta__tel-label">TEL（{site.hours.split('（')[0]}）</span>
        <span class="cta__tel-no">{site.tel}</span>
      </a>
      <a class="btn btn--white" href="/contact/">メールでお問い合わせ</a>
    </div>
  </div>
</section>

<style>
  /* 白地の上に紺の角丸パネルを浮かせる */
  .cta { background: var(--bg-soft); padding: 88px 0; }
  @media (max-width: 600px) { .cta { padding: 56px 0; } }
  .cta__inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; background: linear-gradient(135deg, var(--teal) 0%, var(--navy-deep) 100%); color: #fff; border-radius: 20px; padding: 56px 56px; box-shadow: 0 24px 60px rgba(47, 111, 115, 0.18); position: relative; overflow: hidden; }
  .cta__inner::after { content: ''; position: absolute; right: -120px; top: -140px; width: 380px; height: 380px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.10); pointer-events: none; }
  @media (max-width: 800px) { .cta__inner { grid-template-columns: 1fr; padding: 40px 24px; gap: 28px; border-radius: 16px; } }
  .cta__lead { font-family: var(--font-en), var(--font-sans); color: var(--accent-light); font-size: 0.85rem; letter-spacing: 0.14em; margin-bottom: 8px; }
  .cta__title { color: #fff; font-size: 1.9rem; margin-bottom: 14px; }
  @media (max-width: 600px) { .cta__title { font-size: 1.5rem; } }
  .cta__text { margin: 0; color: rgba(255, 255, 255, 0.88); font-size: 0.95rem; }
  .cta__actions { display: flex; flex-direction: column; gap: 14px; align-items: stretch; position: relative; z-index: 1; }
  .cta__tel { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: #fff; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.22); border-radius: 999px; padding: 12px 20px; transition: background .2s; }
  .cta__tel:hover { background: rgba(255,255,255,0.14); color: #fff; }
  .cta__tel-label { font-size: 0.72rem; color: var(--accent-light); letter-spacing: 0.1em; }
  .cta__tel-no { font-size: 1.7rem; font-weight: 700; font-family: var(--font-en); letter-spacing: 0.05em; line-height: 1.25; }
</style>
